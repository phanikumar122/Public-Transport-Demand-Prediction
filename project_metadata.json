{
  "Project": "Public Transport Demand Prediction",
  "Course": "Data Mining and Data Warehousing (DMDW)",
  "Version": "1.0.0",
  "Description": "End-to-end ML pipeline for multi-modal passenger demand prediction across Bus, Rail, and Air with star-schema data warehouse, OLAP, K-Means clustering, Isolation Forest, and SHAP explainability.",

  "Architecture": {
    "ETL": "src/etl/ — Extract, clean, feature-engineer 3 datasets",
    "DataWarehouse": "src/warehouse/ — MySQL star-schema with OLAP queries",
    "DataMining": "src/mining/ — K-Means clustering + Isolation Forest (all 3 modes)",
    "ML": "src/ml/ — 5 regressors, time-aware split, hyperparameter tuning, SHAP",
    "Prediction": "outputs/predictions/demand_predictions.csv"
  },

  "Datasets": {
    "APSRTC": {
      "rows": 1000,
      "columns": 14,
      "target": "passengers",
      "routes": 15,
      "date_range": "2024-01-01 to 2024-12-30",
      "use": "ETL + DataWarehouse + Mining + ML"
    },
    "Railways": {
      "rows": 8366,
      "columns": 11,
      "target": "passengers (seeded)",
      "use": "ETL + DataWarehouse + Mining + ML"
    },
    "Flights": {
      "rows": 15000,
      "columns": 13,
      "target": "passengers (seeded)",
      "use": "ETL + DataWarehouse + Mining + ML"
    }
  },

  "DataWarehouse": {
    "Database": "transport_dw (MySQL)",
    "Schema": "Star Schema",
    "DimensionTables": ["dim_date", "dim_route", "dim_transport_mode", "dim_location"],
    "FactTables": ["fact_transport", "fact_predictions"],
    "AnalyticsTables": ["ml_model_metrics", "mining_clusters", "mining_anomalies"],
    "OLAP_Operations": ["roll-up", "drill-down", "slice", "dice"]
  },

  "DataMining": {
    "Clustering": {
      "Algorithm": "K-Means",
      "Datasets": ["Bus (APSRTC)", "Rail (IRCTC)", "Air (Flights)"],
      "OptimalK": 4,
      "SilhouetteScore": 0.4193,
      "Clusters": ["Low Demand", "Medium Demand", "High Demand", "Peak-Dependent"],
      "OutputFile": "outputs/predictions/route_clusters.csv"
    },
    "AnomalyDetection": {
      "Algorithm": "Isolation Forest",
      "Contamination": 0.05,
      "Datasets": ["Bus (APSRTC)", "Rail (IRCTC)", "Air (Flights)"],
      "AnomalyRate": "5.00% per mode",
      "OutputFile": "outputs/predictions/transport_anomalies.csv"
    }
  },

  "MachineLearning": {
    "Problem": "Regression (predict passenger count across all 3 transport modes)",
    "Target": "passengers",
    "Datasets": ["APSRTC (Bus)", "IRCTC (Rail)", "Indian Domestic Flights (Air)"],
    "CombinedRows": 24366,
    "SplitStrategy": "Time-aware chronological (Train 70% / Val 15% / Test 15%)",
    "NoShuffle": true,
    "FutureLeakageCheck": true,
    "LeakyFeaturesExcluded": ["revenue", "occupancy_rate", "seats_remaining", "revenue_per_km", "fuel_efficiency"],
    "Features": 27,
    "Models": {
      "Ridge": {"type": "Baseline"},
      "RandomForest": {"n_estimators": 500, "max_depth": 8, "type": "Ensemble"},
      "XGBoost": {"n_estimators": 1000, "max_depth": 4, "early_stopping": true, "type": "GradientBoosting"},
      "LightGBM": {"n_estimators": 1000, "num_leaves": 31, "early_stopping": true, "type": "GradientBoosting"},
      "CatBoost": {"iterations": 1000, "depth": 5, "early_stopping": true, "type": "GradientBoosting"}
    },
    "BestModel": "CatBoost",
    "Tuning": {
      "Method": "RandomizedSearchCV",
      "CV": "TimeSeriesSplit (5 folds)",
      "Scoring": "neg_mean_absolute_error"
    },
    "Outputs": {
      "BestModel": "models/best_model.pkl",
      "AllModels": "models/all_models.pkl",
      "TunedModel": "models/tuned_model.pkl",
      "Metrics": "outputs/metrics/model_metrics.csv",
      "Predictions": "outputs/predictions/demand_predictions.csv"
    }
  },

  "Explainability": {
    "Framework": "SHAP (TreeExplainer)",
    "TopFeatures": [
      "capacity",
      "transport_mode_encoded",
      "rolling_mean_14",
      "mode_type_encoded",
      "week_of_year",
      "rolling_mean_7",
      "lag_7",
      "fare_per_passenger"
    ],
    "Outputs": [
      "reports/figures/shap_global_importance.png",
      "reports/figures/shap_summary_plot.png",
      "reports/figures/shap_waterfall_single.png",
      "outputs/metrics/shap_feature_importance.csv",
      "outputs/metrics/shap_values.csv"
    ]
  },

  "RunCommands": {
    "FullPipeline": "python run_pipeline.py",
    "ETLOnly": "python run_pipeline.py --steps etl",
    "LoadDW": "python run_pipeline.py --steps load_dw",
    "MineOnly": "python run_pipeline.py --steps mine",
    "TrainOnly": "python run_pipeline.py --steps train",
    "TuneOnly": "python run_pipeline.py --steps tune",
    "ExplainOnly": "python run_pipeline.py --steps explain",
    "PredictOnly": "python run_pipeline.py --steps predict",
    "Tests": "python tests/test_pipeline.py",
    "SinglePrediction": "from src.ml.predict import predict_single; predict_single(route='Kurnool-Hyderabad', date='2024-12-15', bus_type='Volvo Ac', distance_km=326, capacity=49)"
  }
}
